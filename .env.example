# Backend the dev server forwards /api to (mainnet backend :8787, local-fork backend :8790)
QUDAO_API=http://localhost:8787
# Production (Vercel): absolute API origin, no trailing slash. Leave empty in dev; Vite proxies /api.
VITE_API_URL=
# BSC RPC the app reads through (wallet transactions go through the wallet's own RPC)
VITE_BSC_RPC=https://bsc-dataseed.bnbchain.org
# WalletConnect project id (free at https://dashboard.reown.com). It adds QR codes and "connect with the app" on phones
# for every wallet in src/lib/wallets.ts. Without it, installed wallets still connect and phones get "open in the wallet's
# browser" links. WalletConnect only works on https pages (or localhost), not on a plain-http LAN address.
VITE_WALLETCONNECT_PROJECT_ID=
# Local fork only: offer a "Dev wallet" that signs with an anvil test account (never set this for a real deployment)
VITE_DEV_WALLET=
